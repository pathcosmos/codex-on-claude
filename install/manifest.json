{
  "$schema": "./manifest.schema.json",
  "version": "0.3.1",
  "name": "codex-on-claude",
  "description": "Install bridge components that let Claude Code call OpenAI Codex CLI via MCP.",
  "questions": {
    "patterns": {
      "type": "multi",
      "label": "Codex 호출 패턴 / Codex invocation patterns",
      "choices": [
        {
          "key": "review",
          "label": "단발 read-only 검토 / one-shot read-only review",
          "skills": ["codex-review"]
        },
        {
          "key": "followup",
          "label": "긴 멀티턴 세션 / long multi-turn session",
          "skills": ["codex-followup", "codex-resume"]
        },
        {
          "key": "fix",
          "label": "워크스페이스 수정 위임 / workspace-write delegation",
          "skills": ["codex-fix"]
        },
        {
          "key": "routine",
          "label": "정형화된 반복 작업 / templated repeating job",
          "skills": ["codex-routine"]
        }
      ]
    },
    "contextPolicy": {
      "type": "single",
      "label": "Codex 응답 컨텍스트 정책 / Codex response context policy",
      "choices": [
        {
          "key": "direct",
          "label": "메인에 직접 표시 / show directly in main context",
          "installAgent": false
        },
        {
          "key": "summarize",
          "label": "요약만 메인으로 (격리) / summary only via subagent",
          "installAgent": true
        },
        {
          "key": "mixed",
          "label": "상황별 혼용 (권장) / mixed per call (recommended)",
          "installAgent": true
        }
      ]
    },
    "improvementLoop": {
      "type": "single",
      "label": "지능적 지속 개선 루프 / continuous improvement loop",
      "choices": [
        {
          "key": "off",
          "label": "끔 / disabled — log/analyze/improve 미설치, hook 없음",
          "enableLogging": false,
          "installAnalyzeSkill": false,
          "registerHooks": false
        },
        {
          "key": "manual",
          "label": "수동 — Skill prose의 MUST 절차로 log 호출. OS hook 없음. (이전 on-demand)",
          "enableLogging": true,
          "installAnalyzeSkill": true,
          "registerHooks": false
        },
        {
          "key": "auto-on-skill",
          "label": "자동 — PostToolUse hook이 mcp__codex__codex 호출마다 log 자동 append (~/.claude/settings.json 변경 동의 필요)",
          "enableLogging": true,
          "installAnalyzeSkill": true,
          "registerHooks": true
        },
        {
          "key": "periodic",
          "label": "주기적 — auto-on-skill 위에 cron/loop 기반 정기 analyze 안내 추가",
          "enableLogging": true,
          "installAnalyzeSkill": true,
          "registerHooks": true,
          "schedule": "weekly"
        }
      ],
      "aliases": {
        "on-demand": "manual"
      }
    },
    "threads": {
      "type": "single",
      "label": "Thread 영속 저장 / persistent thread catalog",
      "choices": [
        {
          "key": "off",
          "label": "끔 / disabled (no catalog)",
          "enableThreads": false,
          "installThreadsSkill": false
        },
        {
          "key": "basic",
          "label": "기본 — threadId + title/tags/lastUsed (권장 default)",
          "enableThreads": true,
          "installThreadsSkill": true,
          "captureSummaries": false,
          "captureIncidents": false
        },
        {
          "key": "full",
          "label": "전체 — 작업 문맥(goal/outcome/decision/note) + incidents + fallbackStrategy",
          "enableThreads": true,
          "installThreadsSkill": true,
          "captureSummaries": true,
          "captureIncidents": true
        }
      ]
    }
  },
  "agent": {
    "name": "codex-reviewer",
    "source": "components/agents/codex-reviewer.md",
    "target": "agents/codex-reviewer.md"
  },
  "skills": {
    "codex-review": {
      "source": "components/skills/codex-review",
      "target": "skills/codex-review"
    },
    "codex-followup": {
      "source": "components/skills/codex-followup",
      "target": "skills/codex-followup"
    },
    "codex-resume": {
      "source": "components/skills/codex-resume",
      "target": "skills/codex-resume"
    },
    "codex-fix": {
      "source": "components/skills/codex-fix",
      "target": "skills/codex-fix"
    },
    "codex-routine": {
      "source": "components/skills/codex-routine",
      "target": "skills/codex-routine"
    },
    "codex-analyze": {
      "source": "components/skills/codex-analyze",
      "target": "skills/codex-analyze"
    },
    "codex-improve": {
      "source": "components/skills/codex-improve",
      "target": "skills/codex-improve"
    },
    "codex-log": {
      "source": "components/skills/codex-log",
      "target": "skills/codex-log"
    },
    "codex-threads": {
      "source": "components/skills/codex-threads",
      "target": "skills/codex-threads"
    }
  },
  "mcp": {
    "name": "codex",
    "command": "codex",
    "args": ["mcp-server"],
    "registerCommand": "claude mcp add --scope user codex -- codex mcp-server",
    "checkCommand": "claude mcp get codex"
  }
}
