{
  "name": "codex-on-claude",
  "version": "0.5.3",
  "description": "Bridge that lets Claude Code call OpenAI Codex CLI as an MCP sub-agent. Installable Skills + optional isolated review Agent, a continuous-improvement loop with optional PostToolUse hook auto-logging, and a persistent thread catalog. Local-only telemetry, arrow-key install UX.",
  "keywords": [
    "claude-code",
    "codex",
    "codex-cli",
    "mcp",
    "anthropic",
    "openai",
    "agent",
    "skill",
    "plugin",
    "ai"
  ],
  "license": "MIT",
  "author": "pathcosmos <lanco.gh@gmail.com>",
  "homepage": "https://github.com/pathcosmos/codex-on-claude#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pathcosmos/codex-on-claude.git"
  },
  "bugs": {
    "url": "https://github.com/pathcosmos/codex-on-claude/issues"
  },
  "type": "module",
  "main": "install/install.mjs",
  "bin": {
    "codex-on-claude": "install/install.mjs"
  },
  "files": [
    "install/install.mjs",
    "install/manifest.json",
    "install/hooks.mjs",
    "install/templater.mjs",
    "install/threads.mjs",
    "install/analyze.mjs",
    "install/detect-signals.mjs",
    "install/auto-probe.mjs",
    "install/cerberus-consensus.mjs",
    "install/cerberus-server.mjs",
    "install/components/",
    "docs/guidance-quick-ref.md",
    "docs/guidance-comparison.md",
    "docs/guidance-claude-only.md",
    "docs/guidance-codex-only.md",
    "docs/guidance-claude-orchestrates-codex.md",
    "docs/synergy-playbook.md",
    "docs/usage-mode-config.md",
    "docs/release-notes-0.5.0.md",
    "docs/security-review-0.5.0.md",
    "README.md",
    "README.ko.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node install/install.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.4.3",
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
}
