{
  "scenario": "D1-doc-self-improve",
  "notes": "Tests doc-authoring + (β only) self-review loop via /codex-review. The β arm should produce slightly more thorough sections after revision.",
  "criteria": [
    { "name": "has_all_5_sections", "type": "doc_section_exists", "args": { "sections": ["Description", "How to invoke", "Guardrails", "MUST procedures", "Edge cases"] } },
    { "name": "no_tbd", "type": "not_contains_text", "args": { "needle": "TBD" } },
    { "name": "no_todo", "type": "not_contains_text", "args": { "needle": "TODO" } },
    { "name": "no_placeholder_brackets", "type": "not_contains_text", "args": { "needle": "[...]" } },
    { "name": "json_sections_field", "type": "final_json_array_min", "args": { "field": "sections_authored", "min": 5 } },
    { "name": "word_count_under_700", "type": "word_count_max", "args": { "max": 700 } },
    { "name": "mentions_token_bucket_or_refill", "type": "contains_text", "args": { "needle": "refill" } },
    { "name": "beta_invoked_codex_review_twice", "type": "arm_specific", "args": {
        "arm": "beta",
        "inner_type": "tool_call_count_min",
        "inner_args": { "name": "mcp__codex__codex", "min": 2 }
    } }
  ]
}
